rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Room codes only identify a waiting room. Never store decks, hands,
    // shuffles, game state, or other hidden information in this document.
    match /friendRooms/{roomCode} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && roomCode.matches('[A-HJ-NP-Z2-9]{8}')
        && request.resource.data.keys().hasOnly(['hostUid', 'guestUid', 'status', 'hostReady', 'guestReady'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.status == 'waiting'
        && request.resource.data.hostReady == false
        && request.resource.data.guestReady == false;

      // Exactly one authenticated guest can fill the empty slot.
      // No caller may change hostUid, status, or previously assigned guestUid.
      allow update: if request.auth != null && (
        // Claim the vacant guest seat once.
        (resource.data.hostUid != request.auth.uid
          && resource.data.guestUid == ''
          && resource.data.status == 'waiting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid'])
          && request.resource.data.guestUid == request.auth.uid)
        ||
        // Each player can change only their own readiness; no deck data stored.
        (resource.data.guestUid != ''
          && resource.data.status == 'waiting'
          && resource.data.hostUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostReady'])
          && request.resource.data.hostReady is bool)
        ||
        (resource.data.guestUid == request.auth.uid
          && resource.data.status == 'waiting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestReady'])
          && request.resource.data.guestReady is bool)
        ||
        // Host can start exactly once, after both players have committed ready.
        (resource.data.hostUid == request.auth.uid
          && resource.data.guestUid != ''
          && resource.data.status == 'waiting'
          && resource.data.hostReady == true
          && resource.data.guestReady == true
          && exists(/databases/$(database)/documents/friendRooms/$(roomCode)/privateDecks/host)
          && exists(/databases/$(database)/documents/friendRooms/$(roomCode)/privateDecks/guest)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'playing')
      );

      allow delete: if false;

      // Private deck snapshots are readable only by their owner.
      // Even the opponent cannot inspect a hand/deck source.
      match /privateDecks/{seat} {
        function ownerOfSeat() {
          return seat == 'host'
            ? get(/databases/$(database)/documents/friendRooms/$(roomCode)).data.hostUid
            : get(/databases/$(database)/documents/friendRooms/$(roomCode)).data.guestUid;
        }

        function roomAllowsDeckWrite() {
          let room = get(/databases/$(database)/documents/friendRooms/$(roomCode)).data;
          return room.status == 'waiting'
            && room.guestUid != ''
            && (seat == 'host' && room.hostReady == false
              || seat == 'guest' && room.guestReady == false);
        }

        function validDeckShape() {
          return request.resource.data.keys().hasOnly(['ownerUid', 'elements', 'cards'])
            && request.resource.data.keys().hasAll(['ownerUid', 'elements', 'cards'])
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.elements is list
            && request.resource.data.elements.size() <= 3
            && request.resource.data.cards is list
            && request.resource.data.cards.size() == 40;
        }

        allow get: if request.auth != null
          && (seat == 'host' || seat == 'guest')
          && ownerOfSeat() == request.auth.uid;
        allow list: if false;

        allow create: if request.auth != null
          && (seat == 'host' || seat == 'guest')
          && ownerOfSeat() == request.auth.uid
          && roomAllowsDeckWrite()
          && validDeckShape();

        allow update: if request.auth != null
          && (seat == 'host' || seat == 'guest')
          && ownerOfSeat() == request.auth.uid
          && resource.data.ownerUid == request.auth.uid
          && roomAllowsDeckWrite()
          && validDeckShape();

        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
