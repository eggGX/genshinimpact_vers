# Firebase project settings (public client configuration, NOT a service-account key)
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key

# Optional: only after deploying the trusted match server.
# Until set, friend matches remain in safe session-only mode.
# VITE_MATCH_SERVER_URL=https://your-trusted-match-server.example
